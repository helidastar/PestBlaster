# Shared secret the turret (ESP32 or simulator) sends in the x-device-key header.
DEVICE_API_KEY=change-me

# Where the SQLite database and snapshots are stored.
PESTBLASTER_DATA_DIR=./data

# Pest detector: "simulated" (Increment 1 stand-in) or "http" (external model server).
DETECTOR=simulated
# Used when DETECTOR=http. See docs/DOCUMENTATION.md, section 13.2.
DETECTOR_URL=http://localhost:8000/detect
